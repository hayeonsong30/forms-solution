// Prisma schema for 폼솔루션 (Form Solution)
// See /Users/neolab/Desktop/forms solution/PRD_폼솔루션_v0.1.md and PRD_양식편집기_상세_v0.1.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  editor
  field_user
  reviewer
}

// 2026-08-20: draft/active + 별도 printable 불리언이라는 두 축짜리 모델이 혼란스럽다는
// 사용자 피드백으로 단일 축으로 재설계. "편집 중"이거나 "인쇄 가능"이거나 둘 중 하나뿐이다.
enum TemplateStatus {
  draft // 편집 가능, 인쇄 불가
  printable // 편집 잠김, 인쇄 가능
}

enum ExcelReportTemplateStatus {
  validating
  invalid
  active
}

enum FieldType {
  text
  number
  check
  date
  time
  choice
}

enum FieldSource {
  manual
  ai
  copied
}

enum FieldStatus {
  suggested
  confirmed
}

enum DocumentStatus {
  printed
  received
  processing
  review_required
  confirmed
  error
}

enum ValueSource {
  ai
  user
  stroke_rule
  empty_rule
}

enum ReviewStatus {
  pending
  needs_review
  confirmed
}

enum AiTargetType {
  template
  document
}

enum AiJobType {
  form_detection
  handwriting_ocr
}

enum AiJobStatus {
  queued
  preprocessing
  processing
  validating
  review_required
  completed
  retrying
  failed
}

enum ExportType {
  csv_single
  csv_batch
  excel_doc
  excel_list
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  contact   String?
  createdAt DateTime @default(now()) @map("created_at")

  users     User[]
  templates Template[]
  documents Document[]

  @@map("organizations")
}

model User {
  id    String   @id @default(uuid())
  orgId String   @map("org_id")
  org   Organization @relation(fields: [orgId], references: [id])
  role  UserRole
  email String   @unique
  name  String

  confirmedDocuments Document[] @relation("DocumentConfirmedBy")
  auditLogs          AuditLog[]

  @@map("users")
}

model Template {
  id               String         @id @default(uuid())
  orgId            String         @map("org_id")
  org              Organization   @relation(fields: [orgId], references: [id])
  name             String
  status           TemplateStatus @default(draft)
  printableReason  String?        @map("printable_reason")
  currentVersionId String?        @map("current_version_id")
  // 이 양식으로 몇 부를 인쇄할 예정인지 — 페이지마다 새 SOBP가 발급되므로
  // 실제 필요한 SOBP 수는 version.pageCount * printCopies. 인쇄 자체는 앱 밖에서
  // 이뤄지므로 이 값은 계획/참고용이고 문서 생성 로직에는 영향을 주지 않는다.
  // 동일 SOBP를 여러 부수가 공유하는 방식(롤 인쇄 등)은 이 설정의 범위 밖이다
  // ("10부 인쇄해주세요"가 자연스러운 표현이라 매수 아닌 부수로 정정, 2026-08-25 —
  // PRD_폼솔루션 §14 미결정#1은 계속 미해결).
  printCopies      Int            @default(1) @map("print_copies")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  versions TemplateVersion[] @relation("TemplateVersions")

  @@map("templates")
}

model TemplateVersion {
  id         String   @id @default(uuid())
  templateId String   @map("template_id")
  template   Template @relation("TemplateVersions", fields: [templateId], references: [id])
  versionNo  Int      @map("version_no")
  pageCount  Int      @map("page_count")
  // 업로드한 원본 PDF (base64). PRD_양식편집기_상세 §8.0: PDF가 없으면 필드 추가·AI추천을 막는다.
  pdfData    String?  @map("pdf_data")
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  fields               Field[]
  repeatGroups         RepeatGroup[]
  documents            Document[]
  excelReportTemplates ExcelReportTemplate[]

  @@unique([templateId, versionNo])
  @@map("template_versions")
}

// 고객이 자기 엑셀 서식에 [데이터키]를 직접 넣어 올리면, 그 서식(병합·서식·이미지)을 그대로
// 유지한 채 최종 확정값으로 치환해 돌려준다. 양식 버전당 활성 템플릿 1개만 둔다.
// (2026-08-26: 문서 1건용/반복행 리스트용으로 doc·list 타입을 나눴었으나, 실제 DigiDox
// 레퍼런스를 보면 두 타입 모두 반복행 슬롯 플레이스홀더[데이터키.NN]를 동일하게 지원하고
// 차이는 그냥 레이아웃뿐이었다 — 타입 구분을 없애고 템플릿 1개로 통합했다.)
model ExcelReportTemplate {
  id                String                     @id @default(uuid())
  templateVersionId String                     @unique @map("template_version_id")
  templateVersion   TemplateVersion            @relation(fields: [templateVersionId], references: [id])
  name              String
  fileName          String                     @map("file_name")
  // 업로드한 원본 .xlsx (base64) — 렌더링 시 매번 이 원본에서 복사해 치환한다.
  fileData          String                     @map("file_data")
  checksum          String
  status            ExcelReportTemplateStatus  @default(validating)
  placeholderCount  Int                        @default(0) @map("placeholder_count")
  // ExcelTemplateValidation 결과(§9): { status, validPlaceholders[], errors[] }
  validationResult  Json                       @map("validation_result")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  @@map("excel_report_templates")
}

model Field {
  id                String      @id @default(uuid())
  templateVersionId String      @map("template_version_id")
  templateVersion   TemplateVersion @relation(fields: [templateVersionId], references: [id])
  pageNo            Int         @map("page_no")
  label             String
  description       String?
  dataKey           String      @map("data_key")
  type              FieldType
  // normalized 0~1 coordinates, page-relative (PRD 편집기 §8.4)
  boxX              Float       @map("box_x")
  boxY              Float       @map("box_y")
  boxW              Float       @map("box_w")
  boxH              Float       @map("box_h")
  required          Boolean     @default(false)
  locked            Boolean     @default(false)
  hidden            Boolean     @default(false)
  source            FieldSource @default(manual)
  status            FieldStatus @default(confirmed)
  config            Json        @default("{}")

  choiceOptions ChoiceOption[]
  fieldValues   FieldValue[]

  @@unique([templateVersionId, dataKey])
  @@map("fields")
}

// "선택"(choice) 필드의 옵션. 표시명/저장값은 항상 있고, 문서에서 해당 체크박스 영역을
// 지정하기 전까지 region은 비어 있다 (편집기 상세 PRD §14.1 "선택 옵션별 판정 영역").
// 2026-08-21: 반복행 컬럼(良/否처럼 반복행 안에서 두 영역이 하나의 값인 경우)에도 옵션을
// 붙일 수 있도록 fieldId를 옵셔널로 바꾸고 repeatColumnId를 추가했다 — 정확히 둘 중
// 하나만 채워진다(앱 레벨에서 강제, DB制약은 아님).
model ChoiceOption {
  id             String        @id @default(uuid())
  fieldId        String?       @map("field_id")
  field          Field?        @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  repeatColumnId String?       @map("repeat_column_id")
  repeatColumn   RepeatColumn? @relation(fields: [repeatColumnId], references: [id], onDelete: Cascade)
  orderNo        Int           @map("order_no")
  label          String
  storedValue    String        @map("stored_value")
  regionX        Float?        @map("region_x")
  regionY        Float?        @map("region_y")
  regionW        Float?        @map("region_w")
  regionH        Float?        @map("region_h")

  @@map("choice_options")
}

model RepeatGroup {
  id                String   @id @default(uuid())
  templateVersionId String   @map("template_version_id")
  templateVersion   TemplateVersion @relation(fields: [templateVersionId], references: [id])
  label             String
  dataKey           String   @map("data_key")
  pageNo            Int      @map("page_no")
  areaX             Float    @map("area_x")
  areaY             Float    @map("area_y")
  areaW             Float    @map("area_w")
  areaH             Float    @map("area_h")
  firstRowArea      Json     @map("first_row_area")
  headerExcludeArea Json?    @map("header_exclude_area")
  rowHeight         Float    @map("row_height")
  maxRows           Int      @map("max_rows")
  blankRowPolicy    String   @map("blank_row_policy")
  useRowNumber      Boolean  @default(false) @map("use_row_number")
  allowDuplicate    Boolean  @default(false) @map("allow_duplicate")
  // PDF에 이미 인쇄된 행별 고정값 (예: No./점검내용) — OCR 대상이 아니라 그대로 출력에 쓰인다.
  // FixedRowValue[] 형태: [{ rowIndex, values: { columnDataKey: value } }]
  fixedRows         Json?    @map("fixed_rows")

  columns     RepeatColumn[]
  fieldValues FieldValue[]

  @@unique([templateVersionId, dataKey])
  @@map("repeat_groups")
}

model RepeatColumn {
  id            String      @id @default(uuid())
  repeatGroupId String      @map("repeat_group_id")
  repeatGroup   RepeatGroup @relation(fields: [repeatGroupId], references: [id])
  orderNo       Int         @map("order_no")
  label         String
  dataKey       String      @map("data_key")
  type          FieldType
  // 첫 데이터 행에서의 열 위치 (정규화 0~1, 페이지 기준) — 반복행 해제 시 복원용
  boxX          Float       @map("box_x")
  boxY          Float       @map("box_y")
  boxW          Float       @map("box_w")
  boxH          Float       @map("box_h")
  required      Boolean     @default(false)
  config        Json        @default("{}")

  choiceOptions ChoiceOption[]
  fieldValues   FieldValue[]

  @@unique([repeatGroupId, dataKey])
  @@map("repeat_columns")
}

model Document {
  id                String         @id @default(uuid())
  templateVersionId String         @map("template_version_id")
  templateVersion   TemplateVersion @relation(fields: [templateVersionId], references: [id])
  orgId             String         @map("org_id")
  org               Organization   @relation(fields: [orgId], references: [id])
  ncode             String?
  // 페이지마다 새 SOBP가 발급되는 게 원칙이라(§14 항목1), 다중 페이지 문서는 페이지별
  // 패턴주소(SOBP)를 따로 들고 있는다. index 0 = 1페이지 ... ncode 필드는 대표값(보통
  // pageNcodes[0])으로 계속 쓴다. 실 펜 SDK 연동 전까지는 문서 생성 시 임시로 채운다.
  pageNcodes        String[]       @default([]) @map("page_ncodes")
  status            DocumentStatus @default(printed)
  pageImages        Json           @default("[]") @map("page_images")
  createdAt         DateTime       @default(now()) @map("created_at")
  // 프로토타입 문서 조회 목록의 "인쇄 / 작성 일시" 둘째 줄 — printed → received로 바뀐 시점.
  receivedAt        DateTime?      @map("received_at")
  confirmedAt       DateTime?      @map("confirmed_at")
  confirmedById     String?        @map("confirmed_by")
  confirmedBy       User?          @relation("DocumentConfirmedBy", fields: [confirmedById], references: [id])

  fieldValues FieldValue[]
  aiJobs      AiJob[]
  exports     Export[]

  @@map("documents")
}

model FieldValue {
  id               String       @id @default(uuid())
  documentId       String       @map("document_id")
  document         Document     @relation(fields: [documentId], references: [id])
  fieldId          String?      @map("field_id")
  field            Field?       @relation(fields: [fieldId], references: [id])
  repeatGroupId    String?      @map("repeat_group_id")
  repeatGroup      RepeatGroup? @relation(fields: [repeatGroupId], references: [id])
  repeatColumnId   String?      @map("repeat_column_id")
  repeatColumn     RepeatColumn? @relation(fields: [repeatColumnId], references: [id])
  rowIndex         Int?         @map("row_index")

  rawOcrValue     String?      @map("raw_ocr_value")
  normalizedValue String?      @map("normalized_value")
  finalValue      String?      @map("final_value")
  valueSource     ValueSource? @map("value_source")
  reviewStatus    ReviewStatus @default(pending) @map("review_status")
  reviewReasons   Json         @default("[]") @map("review_reasons")
  model           String?
  promptVersion   String?      @map("prompt_version")
  confidence      Float?

  // either fieldId (일반 필드) or (repeatGroupId + repeatColumnId + rowIndex) must be set
  @@map("field_values")
}

model AiJob {
  id             String       @id @default(uuid())
  targetType     AiTargetType @map("target_type")
  targetId       String       @map("target_id")
  documentId     String?      @map("document_id")
  document       Document?    @relation(fields: [documentId], references: [id])
  jobType        AiJobType    @map("job_type")
  status         AiJobStatus  @default(queued)
  provider       String
  model          String
  promptVersion  String       @map("prompt_version")
  requestPayload Json?        @map("request_payload")
  responsePayload Json?       @map("response_payload")
  errorMessage   String?      @map("error_message")
  retryCount     Int          @default(0) @map("retry_count")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("ai_jobs")
}

model Export {
  id         String     @id @default(uuid())
  documentId String?    @map("document_id")
  document   Document?  @relation(fields: [documentId], references: [id])
  batch      Json?
  exportType ExportType @map("export_type")
  fileUrl    String?    @map("file_url")
  createdBy  String?    @map("created_by")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@map("exports")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_log")
}
