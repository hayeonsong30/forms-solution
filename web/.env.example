# Database (Phase 0)
DATABASE_URL="postgresql://user@localhost:5432/forms_solution_dev?schema=public"

# AI job queue (Phase 4)
REDIS_URL="redis://localhost:6379"

# Gemini — server-only, never expose to the browser (Phase 4)
GEMINI_API_KEY=
GEMINI_MODEL=
AI_PROVIDER=gemini
AI_PROMPT_VERSION=form-v1
AI_MAX_RETRY=2
AI_REQUEST_TIMEOUT_MS=120000

# Object storage for PDFs / handwriting images (Phase 3)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Auth (Phase 7)
JWT_SECRET=
NEXTAUTH_URL=

NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=
